                  "fontFamily": "$font-body",
                  "fontSize": 17,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "JGjGj",
                  "name": "About P2",
                  "fill": "$text-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Hackathons are my greenhouse: fast, warm and a little chaotic. Four of the fruits on my tree came back golden.",
