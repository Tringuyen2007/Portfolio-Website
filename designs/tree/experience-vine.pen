                {
                  "type": "text",
                  "id": "IvPFl",
                  "name": "About P1",
                  "fill": "$text-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "I'm Tri, a computer science student at the University of Texas at San Antonio. My work lives where machine learning meets the real world — computer vision that sees, models that reason, and the full-stack scaffolding that lets them ship.",
